# ---- Sales Inbox Router — backend environment ----
# Copy to .env and fill in. NEVER commit the real .env.

# Your candidate_id — must be byte-identical everywhere (README, form, requests).
CANDIDATE_ID=manviitnd0408@gmail.com

# Postgres (Supabase free tier). Use the "Connection pooling" / session pooler URI.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# For local dev you may instead point at a local Postgres or leave the sqlite fallback:
#   DATABASE_URL=sqlite:///./dev.db     (dev only — grading requires Postgres)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/inbox_router

# LLM provider — server-side only. The browser must never see these.
# Priority: if GROQ_API_KEY is set it is used; else GEMINI_API_KEY; else the
# deterministic rules fallback. Set only the one you have.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq (OpenAI-compatible, free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS: comma-separated list of allowed frontend origins.
# Add your deployed Vercel origin here. localhost:5173 is for dev.
CORS_ORIGINS=http://localhost:5173

# Gemini concurrency + retry tuning
GEMINI_MAX_CONCURRENCY=5
GEMINI_MAX_RETRIES=3
